# Public address (links in e-mails, GitHub callback, Secure cookies).
MARKETPLACE_URL=https://marketplace.flowplan.org
# Admin API for flowplan-admin – the same value there. Generate: openssl rand -hex 32
MARKETPLACE_ADMIN_TOKEN=
# Optional: name of the token in the audit log (default flowplan-admin).
# MARKETPLACE_ADMIN_TOKEN_LABEL=flowplan-admin
# GitHub OAuth app (callback: https://marketplace.flowplan.org/api/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# SMTP for sign-in links and review notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Flowplan Marketplace <marketplace@flowplan.org>
# SMTP_SECURE=true   # port 465
# Optional: key for CSRF tokens and IP hashes (default: generated in the data volume)
# MARKETPLACE_SECRET=
# Optional: folder with impressum.de.md, datenschutz.en.md, … (default: <data>/legal)
# MARKETPLACE_LEGAL_DIR=
