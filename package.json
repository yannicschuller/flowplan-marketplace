{
  "name": "flowplan-marketplace",
  "version": "0.1.0",
  "private": true,
  "description": "Templates, workflows and looks for Flowplan – shared by the community, reviewed before they are published.",
  "license": "AGPL-3.0-only",
  "homepage": "https://marketplace.flowplan.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/yannicschuller/flowplan-marketplace.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "demo": "node scripts/demo.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "audit": "npm audit --audit-level=low"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "next": "16.4.5",
    "nodemailer": "10.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
